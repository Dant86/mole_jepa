# Copy to .env and fill in your values. .env is gitignored.
#
# Usage:
#   cp .env.sample .env

# Scratch directory for temp files and caches.
# DataLoader shared-memory files (pymp-*) and HuggingFace downloads land here
# instead of /tmp, which is small and shared on compute nodes.
TMPDIR=/path/to/tmpdir
HF_HOME=/path/to/hf_home
HF_DATASETS_CACHE=/path/to/cache

# HuggingFace token — avoids rate-limit warnings on hub requests.
# Generate one at https://huggingface.co/settings/tokens
HF_TOKEN=your_token_here

# Weights & Biases API key — required for experiment tracking.
# Generate one at https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_key_here

# Root directory where prepare_cc3m.sh writes WebDataset shards.
# Shards are written to ${CC3M_LOCAL_DIR}/train/ and ${CC3M_LOCAL_DIR}/validation/.
CC3M_LOCAL_DIR=YOUR_LOCAL_DIR/cc3m-local

# Root directory where prepare_datacomp.sh writes Recap-DataComp shards.
# Filtered metadata: ${DATACOMP_LOCAL_DIR}/filtered.parquet
# Image shards:      ${DATACOMP_LOCAL_DIR}/shards/
DATACOMP_LOCAL_DIR=YOUR_LOCAL_DIR/datacomp-local

# Directory where the NFS registry JSON file lives.
# The registry maps model names to configs and checkpoint directories.
REGISTRY_PATH=YOUR_SCRATCH_DIR/registry

# Directory where training checkpoints and the final model are written.
CHECKPOINT_DIR=YOUR_CHECKPOINT_DIR/checkpoints

# Directory for SLURM job logs.
LOG_DIR=YOUR_LOG_DIR/logs
